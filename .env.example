# Placeholders only. Copy to .env (gitignored) and fill in locally.

# --- security lane ---
# Base URLs of allowlisted targets. Hosts must be loopback or one of the
# compose service names in security/allowlist.py; anything else is refused.
KSX_TARGET_DEMO_URL=http://127.0.0.1:5001
KSX_TARGET_PATCH_URL=http://127.0.0.1:5002
# Where evidence artifacts are written.
KSX_ARTIFACT_DIR=artifacts
# Shared secret the platform backend sends to the security test service
# (header X-KSX-Token). Required for patch submission and patch tests.
KSX_SECURITY_SERVICE_TOKEN=change-me
# Patch tests run in Docker by default. Set to 1 only on a dev machine without
# Docker to run patched code as a local subprocess (NOT a sandbox).
KSX_ALLOW_LOCAL_SANDBOX=0
