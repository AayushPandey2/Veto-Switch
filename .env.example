# ==============================================================================
# Killswitch X — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development.
# NEVER commit `.env` or real credentials to version control.
#
# Security Boundary:
#   - `KILLSWITCH_*` variables power shared and AI-readable services.
#   - `KILLSWITCH_PLATFORM_*` variables belong strictly to the privileged
#     platform layer and MUST NEVER be passed into AI prompts or AI modules.
# ==============================================================================

# --- AI & Shared Service Configuration (Safe / Non-Privileged) ----------------
KILLSWITCH_APP_ENV=development
KILLSWITCH_LOG_LEVEL=INFO
KILLSWITCH_LOG_FORMAT=json

# LLM Provider Settings (offline/fixture mode works without an API key)
KILLSWITCH_LLM_PROVIDER=offline_fixture
KILLSWITCH_LLM_MODEL=unconfigured
KILLSWITCH_LLM_TIMEOUT_SECONDS=30.0
KILLSWITCH_LLM_MAX_RETRIES=2
KILLSWITCH_LLM_MAX_CONTEXT_CHARS=32000
KILLSWITCH_LLM_MAX_INPUT_TOKENS=6000
KILLSWITCH_LLM_MAX_OUTPUT_TOKENS=1500
KILLSWITCH_LLM_FALLBACK_ENABLED=true
KILLSWITCH_LLM_ALLOW_FAILOVER=false

# Read-only service endpoints (for future service integration)
KILLSWITCH_FLAGSMITH_READ_URL=http://127.0.0.1:8001/readonly/flags
KILLSWITCH_SECURITY_VERIFIER_URL=http://127.0.0.1:8002/verify
KILLSWITCH_PATCH_TEST_RUNNER_URL=http://127.0.0.1:8003/patch-tests

# Local artifact & fixture configuration paths
KILLSWITCH_ARTIFACT_DIR=artifacts
KILLSWITCH_ROUTE_REGISTRY_PATH=config/route_flag_map.json
KILLSWITCH_DEPENDENCY_GRAPH_PATH=config/dependency_graph.json
KILLSWITCH_ROLLOUT_POLICY_PATH=config/rollout_policy.json
KILLSWITCH_DEFAULT_PROPOSAL_EXPIRATION_SECONDS=900

# --- Privileged Platform Configuration (DO NOT EXPOSE TO AI MODULES) ----------
# Used exclusively by the future platform execution/persistence layer.
KILLSWITCH_PLATFORM_DATABASE_URL=sqlite:///./killswitch_local.db
KILLSWITCH_PLATFORM_FLAGSMITH_ENVIRONMENT_KEY=replace-with-readonly-env-key-in-platform-only
KILLSWITCH_PLATFORM_FLAGSMITH_MANAGEMENT_TOKEN=replace-with-privileged-token-in-platform-only
KILLSWITCH_PLATFORM_APPROVAL_SIGNING_SECRET=replace-with-platform-signing-secret
