# Copy this file to .env for local runs. Never commit real keys or paste them in chat.
KILLSWITCH_DEMO_ENV=local
KILLSWITCH_DEMO_MODE=false
KILLSWITCH_ALLOW_VULNERABLE_ROUTES=false
KILLSWITCH_FLAG_ADAPTER=local
KILLSWITCH_FLAG_SEARCH_V1=false
KILLSWITCH_FLAG_SEARCH_V2=false
KILLSWITCH_FLAG_FILES_V1=false
KILLSWITCH_FLAG_FILES_V2=false
KILLSWITCH_OPERATOR_PASSPHRASE=local-demo-passphrase

# Set KILLSWITCH_FLAG_ADAPTER=flagsmith after configuring a dedicated demo environment.
# These values stay in the private, ignored .env file on the server side.
KILLSWITCH_PLATFORM_FLAGSMITH_ENVIRONMENT_KEY=
KILLSWITCH_PLATFORM_FLAGSMITH_MANAGEMENT_TOKEN=
KILLSWITCH_PLATFORM_FLAGSMITH_API_URL=https://api.flagsmith.com/api/v1
